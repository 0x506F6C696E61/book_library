/* Таблица сведений о книге */
.book-details {
    display: flex;
    flex-direction: column;
}

.book-detail {
    display: grid;
    grid-template-columns: 40% 60%;
    gap: 20px;
    padding: 14px 0;
    border-bottom: 1px solid #eeeeee;
}

.book-detail:first-child {
    border-top: 1px solid #eeeeee;
}

.book-detail-label {
    font-size: 13px;
    color: #888888;
}

.book-detail-value {
    font-size: 15px;
    color: #181818;
    line-height: 1.5;
}
